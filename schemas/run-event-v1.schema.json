{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode-agent-runtime.local/schemas/run-event-v1.schema.json",
  "title": "GigaCode Agent Runtime run event v1",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "run_id",
    "type",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "gigacode-agent-runtime/run-event-v1"
    },
    "event_id": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]+$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "step_instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
