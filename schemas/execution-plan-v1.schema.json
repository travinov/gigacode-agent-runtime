{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gigacode-agent-runtime.local/schemas/execution-plan-v1.schema.json",
  "title": "GigaCode Agent Runtime execution plan v1",
  "type": "object",
  "required": [
    "schema_version",
    "plan_hash",
    "scenario_hash",
    "config_hash",
    "inputs_hash",
    "scenario_name",
    "scenario_title",
    "source",
    "workspace",
    "inputs",
    "max_parallel_agents",
    "agents",
    "steps",
    "waves",
    "result_reference",
    "resource_hashes",
    "capability_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "gigacode-agent-runtime/execution-plan-v1"
    },
    "plan_hash": {
      "$ref": "#/$defs/hash"
    },
    "scenario_hash": {
      "$ref": "#/$defs/hash"
    },
    "config_hash": {
      "$ref": "#/$defs/hash"
    },
    "inputs_hash": {
      "$ref": "#/$defs/hash"
    },
    "scenario_name": {
      "type": "string",
      "minLength": 1
    },
    "scenario_title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "level",
        "path",
        "root"
      ],
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "max_parallel_agents": {
      "type": "integer",
      "minimum": 1
    },
    "agents": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "result_reference": {
      "type": "string",
      "minLength": 1
    },
    "resource_hashes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "capability_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
